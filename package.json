{
  "name": "@corbanucore/website",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build:api": "esbuild assets/src/api-checkout.ts --bundle --format=iife --platform=browser --target=es2022 --minify --supported:template-literal=false --alias:crypto=./assets/src/crypto-browser.ts --inject:assets/src/browser-shims.ts --outfile=assets/js/api-checkout.js",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "test": "node --test tests/*test.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@scure/base": "1.2.6",
    "@solana/kit": "5.5.1",
    "@solana/web3.js": "1.98.4",
    "@x402/core": "2.18.0",
    "@x402/evm": "2.18.0",
    "@x402/fetch": "2.18.0",
    "@x402/svm": "2.18.0",
    "buffer": "6.0.3",
    "process": "0.11.10",
    "viem": "2.55.16"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "typescript": "5.9.2"
  }
}
